module(name = "cilium")

# Envoy GIT commit SHA of release
#
# renovate: datasource=github-releases depName=envoyproxy/envoy digestVersion=v1.39.1
ENVOY_SHA = "4aaa0d2425e6a59cfe1a82ac7e6e6446d2c8a676"

# Envoy must be the first bazel_dep so that the toolchains it registers (most importantly the
# hermetic LLVM toolchain) take precedence over the ones registered by the other modules below.
bazel_dep(name = "envoy", version = "1.40.0-dev")
bazel_dep(name = "envoy_api", version = "1.40.0-dev")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "googleapis", version = "0.0.0-20251003-2193a2bf")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1.bcr.envoy")
bazel_dep(name = "protoc-gen-validate", version = "1.3.3.envoy")
bazel_dep(name = "quiche", version = "0.0.0-260922-7f07dc4.envoy")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Not used directly, but envoy.bazelrc sets flags on these repositories, which must therefore be
# visible from the main repository.
bazel_dep(name = "boringssl-fips", version = "0.20260929.0.envoy")
bazel_dep(name = "envoy_toolshed", version = "0.5.2.envoy")
bazel_dep(name = "librdkafka", version = "2.15.0")
bazel_dep(name = "proxy-wasm-cpp-host", version = "0.0.0-260704-f2db56a.envoy")
bazel_dep(name = "rules_fuzzing", version = "0.6.0")
bazel_dep(name = "rules_rust", version = "0.74.0.envoy")

# Used by tools/gen_compilation_database.py.
bazel_dep(name = "bazel-compdb", version = "0.0.0-20220906-4086479.envoy", dev_dependency = True)
bazel_dep(name = "google_benchmark", version = "1.9.5", dev_dependency = True, repo_name = "benchmark")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)
bazel_dep(name = "tclap", version = "1.2.5.bcr.1", dev_dependency = True)

####################################################################################
# Envoy
####################################################################################

# Overrides only take effect in the root module, so Envoy (and its in-tree API module) are
# pinned here, and the overrides Envoy's own MODULE.bazel applies are repeated below.
git_override(
    module_name = "envoy",
    commit = ENVOY_SHA,
    patch_strip = 1,
    patches = [
        "//patches:0001-network-Add-callback-for-upstream-authorization.patch",
        "//patches:0002-listener-add-socket-options.patch",
        "//patches:0003-original_dst_cluster-Avoid-multiple-hosts-for-the-sa.patch",
        "//patches:0004-thread_local-reset-slot-in-worker-threads-first.patch",
        "//patches:0005-http-header-expose-attribute.patch",
        "//patches:0006-config-add-grpc-mux-stream-event-callback.patch",
        "//patches:0007-network-Allow-write-filters-to-consume-data-after-e.patch",
        "//patches:0008-tcp_proxy-Allow-filters-to-wait-for-upstream-close.patch",
    ],
    remote = "https://github.com/envoyproxy/envoy.git",
)

git_override(
    module_name = "envoy_api",
    commit = ENVOY_SHA,
    remote = "https://github.com/envoyproxy/envoy.git",
    strip_prefix = "api",
)

# For local development against an Envoy checkout instead of the git repository above, replace
# both git_override()s with:
#
# local_path_override(
#     module_name = "envoy",
#     path = "/home/tammach/go/src/github.com/envoyproxy/envoy",
# )
#
# local_path_override(
#     module_name = "envoy_api",
#     path = "/home/tammach/go/src/github.com/envoyproxy/envoy/api",
# )

single_version_override(
    module_name = "proxy-wasm-cpp-sdk",
    version = "0.0.0-250925-e5256b0.envoy",
)

single_version_override(
    module_name = "boringssl",
    version = "0.20260929.0",
)

single_version_override(
    module_name = "openssl",
    version = "3.5.7.envoy",
)

# Build Envoy with the Cilium selection of extensions.
local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

local_repository(
    name = "envoy_build_config",
    path = "envoy_build_config",
)

envoy_build_config_ext = use_extension("@envoy//bazel:extensions.bzl", "envoy_build_config_ext")

override_repo(
    envoy_build_config_ext,
    envoy_build_config = "envoy_build_config",
)

# Envoy declares the QUICHE test platform implementations as a dev dependency, so they are not
# wired up when Envoy is not the root module. The Envoy integration test libraries need them.
quiche_dev = use_extension("@quiche//:extensions.bzl", "quiche", dev_dependency = True)
quiche_dev.deps(
    quiche_expect_bug_impl_lib = "@envoy//test/common/quic/platform:quiche_expect_bug_impl_lib",
    quiche_test_helpers_impl_lib = "@envoy//test/common/quic/platform:quiche_test_helpers_impl_lib",
    quiche_test_impl_lib = "@envoy//test/common/quic/platform:quiche_test_impl_lib",
    quiche_test_output_impl_lib = "@envoy//test/common/quic/platform:quiche_test_output_impl_lib",
    quiche_thread_impl_lib = "@envoy//test/common/quic/platform:quiche_thread_impl_lib",
)

####################################################################################
# Languages/toolchains
####################################################################################

# Envoy's ASAN test rules depend on @llvm_toolchain_llvm//:symbolizer by its apparent name.
envoy_llvm_ext = use_extension("@envoy//bazel:extensions.bzl", "envoy_llvm_extension")
use_repo(envoy_llvm_ext, "llvm_toolchain_llvm")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    sdks = {
        "linux_amd64": ("go1.27.1.linux-amd64.tar.gz", "63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445"),
        "linux_arm64": ("go1.27.1.linux-arm64.tar.gz", "3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec"),
    },
    version = "1.27.1",
)
use_repo(go_sdk, "go_toolchains")

register_toolchains("@go_toolchains//:all")
