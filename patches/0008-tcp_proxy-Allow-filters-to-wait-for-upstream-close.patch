 constexpr absl::string_view DisableTunnelingFilterStateKey = "envoy.tcp_proxy.disable_tunneling";
+/**
+ * UpstreamFlushWaitTimeoutMs is the key for a per-connection upstream flush wait timeout. A
+ * non-zero ``StreamInfo::UInt64Accessor`` value makes a raw TCP upstream wait for its peer to
+ * close after pending writes have been flushed when the downstream connection closes. Data
+ * received during this interval is discarded because the downstream connection no longer exists.
+ */
+constexpr absl::string_view UpstreamFlushWaitTimeoutMs =
+    "envoy.tcp_proxy.upstream_flush_wait_timeout_ms";
+/**
+ * DownstreamFlushWaitTimeoutMs is the corresponding downstream flush wait timeout. A non-zero
+ * ``StreamInfo::UInt64Accessor`` value makes the downstream connection wait for its peer to close
+ * after pending writes have been flushed when the raw TCP upstream closes normally.
+ */
+constexpr absl::string_view DownstreamFlushWaitTimeoutMs =
+    "envoy.tcp_proxy.downstream_flush_wait_timeout_ms";
 
