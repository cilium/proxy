+TEST_P(TcpProxyTest, UpstreamRemoteDisconnectWaitsForDownstreamPeer) {
+  constexpr uint64_t timeout_ms = 1000;
+  filter_callbacks_.connection_.streamInfo().filterState()->setData(
+      DownstreamFlushWaitTimeoutMs,
+      std::make_unique<StreamInfo::UInt64AccessorImpl>(timeout_ms),
+      StreamInfo::FilterState::LifeSpan::Connection);
+
+  setup(1);
+  raiseEventUpstreamConnected(0);
+
+  EXPECT_CALL(filter_callbacks_.connection_,
+              setDelayedCloseTimeout(std::chrono::milliseconds(timeout_ms)));
+  EXPECT_CALL(filter_callbacks_.connection_,
+              close(Network::ConnectionCloseType::FlushWriteAndDelay));
+  upstream_callbacks_->onEvent(Network::ConnectionEvent::RemoteClose);
+}
